---
import Base from '../layouts/Base.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

interface Props {
  heading: string;
  description: string;
  landing?: boolean;
  noIndex?: boolean;
  backLink?: { href: string; label: string };
}

const { heading, description, landing = false, noIndex = false, backLink } = Astro.props;
const back = backLink ?? (landing ? { href: '/', label: 'Home' } : { href: '/off-the-clock/', label: 'Off the clock' });
---

<Base title={`${heading} | ${site.name}`} description={description} noIndex={noIndex}>
  <header class="personal-header">
    <div>
      <nav aria-label="Back">
        <a href={back.href}>{back.label}</a>
      </nav>
      <h1>{heading}</h1>
    </div>
    <ThemeToggle />
  </header>
  <slot />
</Base>
