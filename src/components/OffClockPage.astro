---
import Base from '../layouts/Base.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

interface Props {
  heading: string;
  description: string;
  landing?: boolean;
  noIndex?: boolean;
}

const { heading, description, landing = false, noIndex = false } = Astro.props;
---

<Base title={`${heading} | ${site.name}`} description={description} noIndex={noIndex}>
  <header class="personal-header">
    <div>
      <nav aria-label="Back">
        {landing ? <a href="/">Home</a> : <a href="/off-the-clock/">Off the clock</a>}
      </nav>
      <h1>{heading}</h1>
    </div>
    <ThemeToggle />
  </header>
  <slot />
</Base>
