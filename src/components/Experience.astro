---
import { experience } from '../data/experience';
---

<section id="experience" class="experience">
  <div class="container">
    <p class="section-label">Experience</p>
    <h2 class="section-title">Where I've worked.</h2>

    <ol class="roles">
      {
        experience.map((role) => (
          <li class="role reveal">
            <div class="role-head">
              <h3 class="role-title">
                {role.title} <span class="role-at">·</span>{' '}
                <span class="role-company">{role.company}</span>
              </h3>
              <span class="role-period">{role.period}</span>
            </div>
            <p class="role-summary">{role.summary}</p>

            {role.metrics && role.metrics.length > 0 && (
              <ul class="metrics">
                {role.metrics.map((m) => (
                  <li class="metric">
                    <span class="metric-value">{m.value}</span>
                    <span class="metric-label">{m.label}</span>
                  </li>
                ))}
              </ul>
            )}

            {role.bullets && role.bullets.length > 0 && (
              <ul class="role-bullets">
                {role.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section-title {
    margin-bottom: var(--sp-8);
  }

  .roles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .role {
    padding-left: var(--sp-5);
    border-left: 1px solid var(--border);
    position: relative;
  }

  .role::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.65rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }

  .role-head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin-bottom: var(--sp-3);
  }

  @media (min-width: 640px) {
    .role-head {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--sp-5);
    }
  }

  .role-title {
    font-size: var(--fs-lg);
    margin: 0;
    color: var(--fg);
  }

  .role-at {
    color: var(--fg-subtle);
    font-weight: 400;
  }

  .role-company {
    color: var(--accent);
  }

  .role-period {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-subtle);
    white-space: nowrap;
    letter-spacing: 0.04em;
  }

  .role-summary {
    margin-bottom: var(--sp-5);
  }

  .metrics {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-5);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-3);
  }

  @media (min-width: 640px) {
    .metrics {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .metric {
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-alt);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    line-height: 1.2;
  }

  .metric-value {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.02em;
  }

  .metric-label {
    font-size: var(--fs-xs);
    color: var(--fg-subtle);
    line-height: var(--lh-snug);
  }

  .role-bullets {
    padding-left: var(--sp-5);
    margin: 0;
  }

  .role-bullets li {
    margin-bottom: var(--sp-3);
  }

  .role-bullets li::marker {
    color: var(--fg-subtle);
  }
</style>
