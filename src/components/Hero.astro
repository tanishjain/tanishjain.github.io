---
import { site } from '../data/site';
---

<section id="top" class="hero">
  <div class="container">
    <p class="hero-eyebrow">Hi, I'm</p>
    <h1 class="hero-name">Tanish Jain.</h1>
    <p class="hero-lede">
      I'm a Senior AI/ML Engineer at <span class="hero-company">Wiley</span>, working
      on AI systems that ground generative models in trusted scholarly and educational
      sources. I build end to end across retrieval, evaluation, and applied ML, and
      publish research on problems I find interesting.
    </p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>
      <a class="btn" href={site.github} rel="noopener noreferrer">GitHub</a>
      <a class="btn" href={site.linkedin} rel="noopener noreferrer">LinkedIn</a>
      <a class="btn" href={site.scholar} rel="noopener noreferrer">Google Scholar</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-10);
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: var(--sp-16);
      padding-bottom: var(--sp-12);
    }
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: var(--fs-sm);
    margin: 0 0 var(--sp-3);
  }

  .hero-name {
    font-size: var(--fs-hero);
    margin-bottom: var(--sp-5);
    color: var(--fg);
  }

  .hero-lede {
    font-size: var(--fs-lg);
    color: var(--fg-muted);
    line-height: var(--lh-loose);
    max-width: 38rem;
    margin-bottom: var(--sp-7);
  }

  .hero-company {
    color: var(--fg);
    font-weight: 600;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
</style>
