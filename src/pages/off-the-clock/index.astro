---
import OffClockPage from '../../components/OffClockPage.astro';
import { offClockSections } from '../../data/off-the-clock';
---

<OffClockPage heading="Off the clock" description="Tanish Jain's notes on food, travel, books, and small favorites." landing>
  <nav aria-label="Off the clock">
    <ul class="work personal-sections">
      {offClockSections.map(({ slug, title, description }) => (
        <li>
          <a href={`/off-the-clock/${slug}/`}>{title}</a>
          <p>{description}</p>
        </li>
      ))}
    </ul>
  </nav>
</OffClockPage>
