---
import OffClockPage from '../../components/OffClockPage.astro';
import { travelSection } from '../../data/off-the-clock';
import { site } from '../../data/site';
import { placesLived, placesVisited } from '../../data/travel';

const sections = [
  { id: 'places-visited', heading: "Places I've visited", places: placesVisited },
  { id: 'places-lived', heading: "Places I've lived", places: placesLived },
];
---

<OffClockPage heading={travelSection.title} description={travelSection.description} noIndex>
  <p class="travel-intro bio">
    I'll add the meals I still think about, the tips I'd pass on, and the stories I keep meaning to write down.
  </p>

  {sections.map(({ id, heading, places }) => (
    <section class="entries" aria-labelledby={id}>
      <h2 id={id}>{heading}</h2>
      <ul class="places">
        {places.map(({ name, cities, years, notes }) => {
          const context = years?.join(', ') ?? cities;

          return (
            <li>
              {notes?.length ? (
                <details>
                  <summary>
                    <span class="place-name">{name}</span>
                    {context && <span class="place-context">{context}</span>}
                  </summary>
                  <ul class="travel-notes">
                    {notes.map(({ slug, title }) => (
                      <li><a href={`/off-the-clock/travel/${slug}/`}>{title}</a></li>
                    ))}
                  </ul>
                </details>
              ) : (
                <p>
                  <span class="place-name">{name}</span>
                  {context && <span class="place-context">{context}</span>}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))}

  <footer class="travel-footer bio">
    <p>
      Want tips for a trip or the longer version of a story?
      <a href={`mailto:${site.email}?subject=Travel%20tips`}>Drop me a line</a>.
      I'd love your recommendations, too. My list of places to go was never going to get shorter anyway.
    </p>
  </footer>
</OffClockPage>

<style>
  .travel-intro {
    margin-bottom: 1.4rem;
    color: var(--fg-muted);
  }

  .places {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .places li + li {
    margin-top: 0.4rem;
  }

  .travel-footer {
    margin-top: 2rem;
  }

  .place-name {
    font-weight: 550;
  }

  .place-context {
    display: inline-block;
    margin-inline-start: 0.5rem;
    color: var(--fg-muted);
    font: 0.875rem/1.5 var(--sans);
  }

  summary {
    cursor: pointer;
    color: var(--accent);
  }

  .travel-notes {
    margin: 0.35rem 0 0.65rem;
    border-inline-start: 1px solid var(--border);
    padding-inline-start: 1rem;
    list-style: none;
    font-size: 1rem;
  }
</style>
